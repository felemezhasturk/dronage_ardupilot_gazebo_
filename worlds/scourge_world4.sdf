<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="scourge_world_desert">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.85 0.85 0.85 1</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <background>0.35 0.35 0.35 1.0</background>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-38.7755936</latitude_deg>
      <longitude_deg>-9.1375554</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
      <!-- NED instead of ENU: Didnt worked -->
      <!-- <world_frame_orientation>ENU</world_frame_orientation> -->
    </spherical_coordinates>
    <!-- A global light source -->
    <light name="sun" type="directional">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.4</direction>
    </light>
    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <!-- TODO: FH: Try MinimalScene instead of GzScene3D -->
        <gz-gui>
          <title>3D View</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <!-- <camera_follow>
          <target>X3</target>
          <p_gain>0.5</p_gain>
          <offset>-3 0.5 11</offset>
        </camera_follow> -->
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property>
          <property key="height" type="double">72</property>
          <property key="width" type="double">121</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"></line>
            <line own="bottom" target="bottom"></line>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property>
          <property key="height" type="double">110</property>
          <property key="width" type="double">290</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"></line>
            <line own="bottom" target="bottom"></line>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="ImageDisplay" name="ImageDisplay">
        <gz-gui>
          <property key="resizable" type="bool">true</property>
          <property key="width" type="double">500</property>
          <property key="height" type="double">500</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">true</property>
        </gz-gui>
        <topic>camera</topic>
        <!-- ? -->
      </plugin>
      <!-- Inspector -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>
      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>
    </gui>
    <include>
      <uri>../models/iris_with_gimbal</uri>
      <pose degrees="true">0 0 0.5 0 0 90</pose>
    </include>
    <include>
      <name>military_boss_1</name>
      <pose>3 -20 0.07 0 0 0</pose>
      <uri>../models/Military_Action_Figure_SG_v2</uri>
    </include>
    <include>
      <name>dronehunter_1</name>
      <pose>2 2 1.05 0 0 3.15</pose>
      <uri>../models/dronehunter</uri>
    </include>
    <include>
      <name>dronehunter_2</name>
      <pose>10 -5 1.05 0 0 0</pose>
      <uri>../models/dronehunter</uri>
    </include>
    <include>
      <name>dronehunter_3</name>
      <pose>15 -6 1.05 0 0 0</pose>
      <uri>../models/dronehunter</uri>
    </include>
    <include>
      <name>dronehunter_4</name>
      <pose>30 5 1.05 0 0 0</pose>
      <uri>../models/dronehunter</uri>
    </include>
    <include>
      <name>dronehunter_5</name>
      <pose>-10 -8 1.05 0 0 1</pose>
      <uri>../models/dronehunter</uri>
    </include>
    <include>
      <name>heavyMachine_1</name>
      <pose>-14 -2 1.05 0 0 0</pose>
      <uri>../models/heavyMachine</uri>
    </include>
    <include>
      <name>desert_camp</name>
      <pose>0 0 -10.2 0 0 0</pose>
      <uri>../models/desert_camp</uri>
    </include>
	<actor name="leopard tank">
	     <!-- <pose>-20 0.7 -.35 1.58 0 0</pose> -->
	     <pose>-20 0.7 1.05 1.58 0 0</pose>
	     <skin>
		<filename>../models/leopard2/meshes/leopard2.obj</filename>
	     </skin>
	     <!-- <animation name="walk"> -->
	     <!--   <filename>../models/walk.dae</filename> -->
	     <!--   <interpolate_x>true</interpolate_x> -->
	     <!-- </animation> -->
	     <script>
	       <loop>true</loop>
	       <delay_start>0.0</delay_start>
	       <auto_start>true</auto_start>
	       <trajectory id="0" type="circular">
	         <waypoint>
	           <time>0</time>
	     		<pose>0 0 0 0 0 0</pose>
	         </waypoint>
	         <waypoint>
	           <time>15</time>
	     		<pose>70 0 0 0 0 0</pose>
	         </waypoint>
	         <waypoint>
	           <time>2.01</time>
	     		<pose>0 0 0 0 0 0</pose>
	         </waypoint>
	       </trajectory>
	     </script>
	   </actor>
    <actor name="actor_walking">
      <skin>
        <filename>../models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>../models/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" tension="1" type="walk">
          <waypoint>
            <time>0</time>
            <pose>0 0 1.05 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>15</time>
            <pose>40 0 1.05 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>15.5</time>
            <pose>40 0 1.05 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>17</time>
            <pose>40 4 1.05 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>17.5</time>
            <pose>40 4 1.05 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>0 4 1.05 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>30.5</time>
            <pose>0 4 1.05 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>32</time>
            <pose>0 0 1.05 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>32.5</time>
            <pose>0 0 1.05 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
